{
  "name": "time-capsules",
  "private": true,
  "version": "26.08.06",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:api": "wrangler pages dev public --port 8788",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "preview": "vite preview",
    "qa:validate": "tsx scripts/05-qa-validate.ts",
    "seed:e2e-emulator": "npx tsx scripts/seed-e2e-emulator.ts",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name=timecapsules --branch main"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "reicon-react": "^1.1.302"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.1.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.108.0"
  }
