# Firebase web app config (Firebase Console > Project Settings > General > Your apps > Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only needed if the QR pairing API is hosted on a separate domain.
# Leave empty when using Cloudflare Pages Functions (same origin as the app).
# VITE_PAIR_WORKER_URL=
